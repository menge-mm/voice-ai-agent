# Voice AI Agent - Environment Configuration Example
# Copy this file to .env and fill in your values

# ================================
# OpenAI Configuration
# ================================
# Get your API key from: https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-your-openai-api-key-here

# OpenAI model to use (options: gpt-4, gpt-4-turbo, gpt-3.5-turbo)
OPENAI_MODEL=gpt-4-turbo

# OpenAI API settings
OPENAI_TEMPERATURE=0.7
OPENAI_MAX_TOKENS=500

# ================================
# TTS (Text-to-Speech) Configuration
# ================================
# TTS model (default: XTTS-v2)
TTS_MODEL=tts_models/multilingual/multi-dataset/xtts_v2

# Default voice file path (optional)
# Provide a 6+ second audio file of the voice you want to use
DEFAULT_VOICE_PATH=voices/default_en.wav

# TTS cache directory
TTS_CACHE_DIR=.cache/tts

# ================================
# Application Settings
# ================================
# Default language (options: en, es, fr, de, it, pt, pl, tr, ru, nl, cs, ar, zh-cn, ja, hu, ko, hi)
DEFAULT_LANGUAGE=en

# Log level (options: DEBUG, INFO, WARNING, ERROR, CRITICAL)
LOG_LEVEL=INFO

# ================================
# Server Configuration
# ================================
# Server host and port
HOST=0.0.0.0
PORT=8000

# CORS allowed origins (comma-separated)
# For development: http://localhost:3000,http://127.0.0.1:3000
# For production: https://yourdomain.com
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# ================================
# Conversation Settings
# ================================
# Maximum conversation history messages to keep
MAX_CONVERSATION_HISTORY=10

# Conversation timeout in minutes
CONVERSATION_TIMEOUT_MINUTES=30

# ================================
# Rate Limiting
# ================================
# Maximum requests per minute per IP
MAX_REQUESTS_PER_MINUTE=60

# ================================
# GPU Configuration
# ================================
# Force CPU even if GPU is available (set to true to disable GPU)
FORCE_CPU=false

# CUDA device ID (if multiple GPUs available)
CUDA_DEVICE=0

# ================================
# Production Settings (Optional)
# ================================
# Redis URL for conversation storage (optional)
# REDIS_URL=redis://localhost:6379/0

# Sentry DSN for error tracking (optional)
# SENTRY_DSN=https://your-sentry-dsn

# API key for securing endpoints (optional)
# API_SECRET_KEY=your-secret-key-here

# ================================
# File Upload Settings
# ================================
# Maximum file size for voice uploads (in MB)
MAX_UPLOAD_SIZE_MB=10

# Allowed audio file types
ALLOWED_AUDIO_FORMATS=wav,mp3,ogg,flac,m4a

# ================================
# Advanced Settings
# ================================
# Enable response streaming
ENABLE_STREAMING=true

# Enable TTS caching
ENABLE_TTS_CACHE=true

# Worker processes (for production)
WORKERS=4

# ================================
# Development Settings
# ================================
# Enable debug mode (DO NOT use in production)
DEBUG=false

# Enable auto-reload (development only)
RELOAD=true
